{
  "name": "iceberg-sink-connector",
  "config": {
    "connector.class": "io.tabular.iceberg.connect.IcebergSinkConnector",
    "tasks.max": "1",
    "topics": "cdc.public.customers",
    "iceberg.tables": "default.customers",
    "iceberg.table.default.customers.route-regex": ".*customers.*",
    "iceberg.tables.auto-create-enabled": "true",
    "iceberg.tables.upsert-mode-enabled": "true",
    "iceberg.tables.default-id-columns": "id",
    "iceberg.tables.cdc-field": "__op",
    "iceberg.tables.cdc.ops.insert": "c",
    "iceberg.tables.cdc.ops.update": "u",
    "iceberg.tables.cdc.ops.delete": "d",
    "iceberg.control.commit.interval-ms": "10000",

    "iceberg.catalog.type": "rest",
    "iceberg.catalog.uri": "http://ite-rustfs:9000/iceberg",
    "iceberg.catalog.warehouse": "warehouse",
    "iceberg.catalog.io-impl": "org.apache.iceberg.aws.s3.S3FileIO",
    "iceberg.catalog.s3.endpoint": "http://ite-rustfs:9000",
    "iceberg.catalog.s3.path-style-access": "true",
    "iceberg.catalog.s3.access-key-id": "admin",
    "iceberg.catalog.s3.secret-access-key": "admin123",
    "iceberg.catalog.client.region": "us-east-1",

    "iceberg.catalog.rest.sigv4-enabled": "true",
    "iceberg.catalog.rest.signing-name": "s3",
    "iceberg.catalog.rest.signing-region": "us-east-1",
    "iceberg.catalog.rest.access-key-id": "admin",
    "iceberg.catalog.rest.secret-access-key": "admin123",

    "key.converter": "io.confluent.connect.avro.AvroConverter",
    "key.converter.schema.registry.url": "http://istad-schema-registry:8081",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "http://istad-schema-registry:8081",

    "errors.tolerance": "all",
    "errors.log.enable": "true",
    "errors.log.include.messages": "true",

    "transforms": "unwrap",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.add.fields": "op",
    "transforms.unwrap.drop.tombstones": "false",
    "transforms.unwrap.delete.handling.mode": "rewrite"
  }
}
