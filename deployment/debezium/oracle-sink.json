{
  "name": "oracle-sink-connector",
  "config": {
    "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "topics": "cdc.public.customers",
    "connection.url": "jdbc:oracle:thin:@//ite-oracle:1521/FREEPDB1",
    "connection.username": "iteuser",
    "connection.password": "qwerqwer",
    "hibernate.dialect": "org.hibernate.dialect.OracleDialect",
    "insert.mode": "upsert",
    "primary.key.mode": "record_key",
    "primary.key.fields": "id",
    "delete.enabled": "true",
    "schema.evolution": "none",
    "quote.identifiers": "false",
    "transforms": "route",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": ".*customers.*",
    "transforms.route.replacement": "CUSTOMERS",
    "key.converter": "io.confluent.connect.avro.AvroConverter",
    "key.converter.schema.registry.url": "http://istad-schema-registry:8081",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "http://istad-schema-registry:8081"
  }
}